APP_LOGIN_PASSWORD=change-this-password
ANIU_IMAGE_TAG=local

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

MX_APIKEY=
MX_API_URL=https://mkapi2.dfcfs.com/finskillshub

# Optional Jev shadow assessment; leave empty to disable paid requests.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Optional local HTTP proxy for Docker Desktop on Windows.
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897
# ALL_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,aniu

EMAIL_ALERTS_ENABLED=false
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# 可选项：如果你希望容器重启或重建后保持登录态稳定，再手动取消注释并设置固定值。
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRE_HOURS=168
# 可选项：如果你需要显式指定数据库路径，可取消注释并保持固定文件名。
# SQLITE_DB_PATH=/app/data/aniu.sqlite3
